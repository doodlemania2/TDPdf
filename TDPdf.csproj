<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\tdpdf-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.17.0.0</Version>
    <AssemblyVersion>1.17.0.0</AssemblyVersion>
    <FileVersion>1.17.0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <!-- Docnet.Core supplies pdfium.dll as a win-x64 native runtime asset; the SDK bundles it for single-file publish. -->
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <!-- OCR engine. We embed the x64 natives as resources and self-extract them at runtime
         (Services/OcrNativeBootstrap), so the package's loose x86/x64 native copies in the output are dead
         weight. ExcludeAssets stops that copy while keeping the managed assembly (compile/runtime) and the
         GeneratePathProperty path used by the EmbeddedResource entries below. -->
    <PackageReference Include="Tesseract" Version="5.2.0" GeneratePathProperty="true" ExcludeAssets="build;buildTransitive;native;contentFiles" />
    <PackageReference Include="Microsoft.ApplicationInsights" Version="2.22.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Printing" />
    <Reference Include="ReachFramework" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\tdpdf-icon.ico" />
    <!-- Generic stock PDF icon used for the .pdf file-type association
         (DefaultIcon). The company logo stays as the application icon. -->
    <Resource Include="Resources\pdf-file.ico" />
    <!-- Brand crest shown on the startup splash (see StartupSplash.cs). -->
    <Resource Include="Resources\splash-logo.png" />
  </ItemGroup>

  <!--
    Build-time-embedded telemetry key. EmbeddedTelemetry.Generated.cs is
    produced by build\embed-telemetry-key.ps1 just before publish and is
    gitignored; when it exists, it replaces the placeholder constants in
    EmbeddedTelemetry.cs so the published EXE auto-provisions on first
    run. When the generated file is absent (CI builds, dev builds, the
    GPLv3 source bundle), the placeholder ships and telemetry is a
    no-op unless an admin opts in via `TDPdf.exe /set-telemetry`.
  -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)Diagnostics\EmbeddedTelemetry.Generated.cs')">
    <Compile Remove="Diagnostics\EmbeddedTelemetry.cs" />
  </ItemGroup>

  <!-- OCR: embed only the native Tesseract libs (x64) so the app still ships as a single exe. Language data
       is NOT bundled - it is downloaded on demand on first OCR (see EnsureOcrModelsReadyAsync in Ocr.cs),
       which keeps the exe small. OcrNativeBootstrap self-extracts the natives to a per-version cache under
       %LOCALAPPDATA%\TDPdf on first use, the same self-extract pattern the single-file host uses for the
       managed assemblies. PkgTesseract comes from GeneratePathProperty on the package reference above. -->
  <ItemGroup>
    <EmbeddedResource Include="$(PkgTesseract)\x64\tesseract50.dll" Condition="'$(PkgTesseract)' != ''">
      <LogicalName>TDPdf.OcrNative.tesseract50.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PkgTesseract)\x64\leptonica-1.82.0.dll" Condition="'$(PkgTesseract)' != ''">
      <LogicalName>TDPdf.OcrNative.leptonica-1.82.0.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Local pdfium.dll override hook. Current builds normally get pdfium.dll from Docnet.Core's runtime assets. -->
    <None Include="pdfium.dll" Condition="Exists('pdfium.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- GPL3 source bundle: produces <AppName>-<Version>-src.zip in the publish folder every time you Publish. -->
  <Target Name="BundleSource" AfterTargets="Publish">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)build\bundle-source.ps1&quot; -ProjectDir &quot;$(ProjectDir.TrimEnd('\'))&quot; -Version &quot;$(Version)&quot; -AppName &quot;$(AssemblyName)&quot; -PublishDir &quot;$(PublishDir.TrimEnd('\'))&quot;" IgnoreExitCode="true" />
  </Target>

</Project>
