<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\tdpdf-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.30.0.0</Version>
    <AssemblyVersion>1.30.0.0</AssemblyVersion>
    <FileVersion>1.30.0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- The vendored PdfSharpCore (netstandard2.0, AnyCPU) is referenced by this x64 app. By default
         the SDK unsets the parent's Configuration/Platform when building the ProjectReference, so the
         vendored lib fell back to its own default (Debug) even on a Release app build. Keep the parent
         Configuration (Release) flowing to the vendored lib so it builds optimized. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- The vendored PdfSharpCore builds as its own ProjectReference (netstandard2.0); keep the app's
       implicit source globs OUT of third_party or every vendored file compiles twice. -->
  <ItemGroup>
    <Compile Remove="third_party\**" />
    <!-- tests/ is a separate console project (see tests/Redaction) and must not compile
         into the app; the default globs would otherwise pull it in. -->
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="third_party\**" />
    <None Remove="third_party\**" />
    <Content Remove="third_party\**" />
    <Page Remove="third_party\**" />
    <Resource Remove="third_party\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- PdfSharpCore is vendored (third_party/PdfSharpCore, MIT) so PDF/A conformance bugs can be
         patched at the source - see third_party/PdfSharpCore/VENDORED.txt. Replaces the former
         NuGet PackageReference PdfSharpCore 1.3.67. -->
    <ProjectReference Include="third_party\PdfSharpCore\PdfSharpCore.csproj" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <!-- Docnet.Core is used for its MANAGED wrapper only; its pdfium.dll is excluded and
         bblanchon.PDFium.Win32 supplies the native instead. Docnet 2.6.0 last shipped in
         September 2023 and its build (426 exports) is missing FPDFFormObj_RemoveObject, so an
         object inside a Form XObject can be enumerated but not removed - and an OCR'd scan keeps
         its text layer in exactly such an object, which is the document people most want to
         redact. It also lacks FPDFPageObj_SetIsActive, FPDFText_GetTextObject and
         FPDFPage_InsertObjectAtIndex. Verified by parsing both DLLs' PE export tables, not by
         reading changelogs.

         BOTH `native` and `build` must be excluded. Docnet ships build/net45/Docnet.Core.targets
         which copies runtimes/$(DocnetRuntime)/native/pdfium.* as Content with
         CopyToOutputDirectory=Always, so excluding only `native` would still leave a second
         pdfium.dll in the output.

         Shipping two natives with the simple name `pdfium` is the failure this avoids: the first
         LoadLibrary wins and BOTH DllImport sets bind to it, and under PublishSingleFile with
         IncludeNativeLibrariesForSelfExtract you get whichever copy lands in the extraction
         directory - silent and machine-dependent. There must be exactly one. -->
    <PackageReference Include="Docnet.Core" Version="2.6.0" ExcludeAssets="native;build;buildTransitive" />
    <!-- The native, pinned. 154.0.8035 is the same build published at
         github.com/bblanchon/pdfium-binaries chromium/8035; the package payload is byte-identical
         to that release asset (sha256 ccfac1aa...). Standard runtimes/<rid>/native layout, so the
         SDK bundles it for single-file publish exactly as Docnet's was. -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="154.0.8035" />
    <!-- OCR engine. We embed the x64 natives as resources and self-extract them at runtime
         (Services/OcrNativeBootstrap), so the package's loose x86/x64 native copies in the output are dead
         weight. ExcludeAssets stops that copy while keeping the managed assembly (compile/runtime) and the
         GeneratePathProperty path used by the EmbeddedResource entries below. -->
    <PackageReference Include="Tesseract" Version="5.2.0" GeneratePathProperty="true" ExcludeAssets="build;buildTransitive;native;contentFiles" />
    <!-- OTLP export to the self-hosted SigNoz collector — the sole telemetry destination since
         1.24.0.0, when Application Insights was retired. Deliberately the plain OpenTelemetry SDK
         rather than the Azure Monitor distro: nothing here should depend on a specific vendor's
         backend, which is what made that retirement a dependency deletion rather than a rewrite. -->
    <PackageReference Include="OpenTelemetry" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Printing" />
    <Reference Include="ReachFramework" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\tdpdf-icon.ico" />
    <!-- Generic stock PDF icon used for the .pdf file-type association
         (DefaultIcon). The company logo stays as the application icon. -->
    <Resource Include="Resources\pdf-file.ico" />
    <!-- Brand crest shown on the startup splash (see StartupSplash.cs). -->
    <Resource Include="Resources\splash-logo.png" />
  </ItemGroup>

  <!-- OCR: embed only the native Tesseract libs (x64) so the app still ships as a single exe. Language data
       is NOT bundled - it is downloaded on demand on first OCR (see EnsureOcrModelsReadyAsync in Ocr.cs),
       which keeps the exe small. OcrNativeBootstrap self-extracts the natives to a per-version cache under
       %LOCALAPPDATA%\TDPdf on first use, the same self-extract pattern the single-file host uses for the
       managed assemblies. PkgTesseract comes from GeneratePathProperty on the package reference above. -->
  <ItemGroup>
    <EmbeddedResource Include="$(PkgTesseract)\x64\tesseract50.dll" Condition="'$(PkgTesseract)' != ''">
      <LogicalName>TDPdf.OcrNative.tesseract50.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(PkgTesseract)\x64\leptonica-1.82.0.dll" Condition="'$(PkgTesseract)' != ''">
      <LogicalName>TDPdf.OcrNative.leptonica-1.82.0.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Third-party licence notices. MIT and BSD both require their copyright notice to travel
       with binary distributions, and Apache-2.0 section 4(a) requires a copy of the licence
       itself; TDPdf ships as a single self-contained exe, so those components are physically
       inside the binary the user receives and the notices have to be inside it too. A loose
       file beside the exe would not survive single-file publish, hence EmbeddedResource.
       Regenerate with build/generate-third-party-notices.ps1; read at runtime by
       ThirdPartyLicensesWindow. -->
  <ItemGroup>
    <EmbeddedResource Include="THIRD-PARTY-NOTICES.md">
      <LogicalName>TDPdf.THIRD-PARTY-NOTICES.md</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Local pdfium.dll override hook. Current builds normally get pdfium.dll from Docnet.Core's runtime assets. -->
    <None Include="pdfium.dll" Condition="Exists('pdfium.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- GPL3 source bundle: produces <AppName>-<Version>-src.zip in the publish folder every time you Publish.
       Shells out to Windows PowerShell on Windows and to pwsh elsewhere: the CI release runs on a LINUX
       runner, where `powershell` does not exist, so this Exec failed every time and — because it is
       IgnoreExitCode — did so silently, which is why tagged releases carried no source zip.
       ProjectDir/PublishDir are trimmed of BOTH separators since MSBuild uses '/' off Windows. -->
  <PropertyGroup>
    <_BundleShell Condition="'$(OS)' == 'Windows_NT'">powershell</_BundleShell>
    <_BundleShell Condition="'$(OS)' != 'Windows_NT'">pwsh</_BundleShell>
  </PropertyGroup>
  <Target Name="BundleSource" AfterTargets="Publish">
    <Exec Command="$(_BundleShell) -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)build/bundle-source.ps1&quot; -ProjectDir &quot;$(ProjectDir.TrimEnd('\').TrimEnd('/'))&quot; -Version &quot;$(Version)&quot; -AppName &quot;$(AssemblyName)&quot; -PublishDir &quot;$(PublishDir.TrimEnd('\').TrimEnd('/'))&quot;" IgnoreExitCode="true" />
  </Target>

</Project>
