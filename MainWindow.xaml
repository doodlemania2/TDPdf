<Window x:Class="TDPdf.MainWindow" Icon="pack://application:,,,/Resources/tdpdf-icon.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TDPdf"
        xmlns:controls="clr-namespace:TDPdf.Controls"
        mc:Ignorable="d"
        Title="TDPdf" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDark}"
        KeyboardNavigation.TabNavigation="Continue"
        KeyboardNavigation.ControlTabNavigation="Continue">

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Open}" Executed="OpenCommand_Executed"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Save}" Executed="SaveCommand_Executed"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Print}" Executed="PrintCommand_Executed"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="FindCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.NewDocumentCommand}" Executed="NewCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.CloseFileCommand}" Executed="CloseFileCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.UndoCommand}" Executed="UndoCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.RedoCommand}" Executed="RedoCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.SaveAsCommand}" Executed="SaveAsCommand_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.AboutCommand}" Executed="AboutCommand_Executed"/>
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{x:Static ApplicationCommands.Open}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static ApplicationCommands.Save}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.SaveAsCommand}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="{x:Static ApplicationCommands.Print}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static local:MainWindow.NewDocumentCommand}"/>
        <KeyBinding Key="W" Modifiers="Control" Command="{x:Static local:MainWindow.CloseFileCommand}"/>
        <KeyBinding Key="W" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.CloseOtherTabsCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{x:Static local:MainWindow.UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{x:Static local:MainWindow.RedoCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.RedoCommand}"/>
        <KeyBinding Key="F1" Command="{x:Static local:MainWindow.AboutCommand}"/>
        <!-- #153: the punctuation zoom chords are NOT KeyBindings any more. A KeyBinding matches a
             virtual key, i.e. a key POSITION, which silently assumes a US layout — on German "="
             is Shift+0 and the extra Shift breaks the match a second time. They now live in
             OnPreviewKeyDown (TryPunctuationShortcut), matched by the character the key TYPES on
             the active layout. The numpad twins stay here: the numpad is layout-independent, and
             Ctrl+NumPad0 gives every layout a zoom reset even where the digit row needs Shift. -->
        <KeyBinding Key="D0" Modifiers="Control" Command="{x:Static local:MainWindow.ZoomResetRoutedCommand}"/>
        <KeyBinding Key="NumPad0" Modifiers="Control" Command="{x:Static local:MainWindow.ZoomResetRoutedCommand}"/>
        <KeyBinding Key="Add" Modifiers="Control" Command="{x:Static local:MainWindow.ZoomInRoutedCommand}"/>
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{x:Static local:MainWindow.ZoomOutRoutedCommand}"/>
        <!-- #135: display-only document dark mode. Ctrl+I is free in TDPdf (no bold/italic/underline
             text styling), so it keeps the discoverable, conventional binding rather than upstream's
             bare N. -->
        <KeyBinding Key="I" Modifiers="Control" Command="{x:Static local:MainWindow.InvertColorsCommand}"/>
        <!-- App-wide UI scale (AppScale.cs) — the chrome, NOT the page. Deliberately Ctrl+Shift so
             it can never be confused with the Ctrl+0/+/- document zoom above; Ctrl+Shift+S and
             Ctrl+Shift+Z are the only Ctrl+Shift letters already taken. -->
        <!-- #153 again: the punctuation halves moved to TryPunctuationShortcut, where they are
             ALSO tested ahead of the plain Ctrl zoom chords — those ignore Shift, so a
             Ctrl+Shift+= would otherwise be eaten as a zoom-in. -->
        <KeyBinding Key="Add"      Modifiers="Control+Shift" Command="{x:Static local:MainWindow.AppScaleUpCommand}"/>
        <KeyBinding Key="Subtract" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.AppScaleDownCommand}"/>
        <KeyBinding Key="D0"       Modifiers="Control+Shift" Command="{x:Static local:MainWindow.AppScaleResetCommand}"/>
        <KeyBinding Key="NumPad0"  Modifiers="Control+Shift" Command="{x:Static local:MainWindow.AppScaleResetCommand}"/>
        <!-- The unmodified tool keys (V / P / 1-0 / T X I H K U S D E G C) are deliberately NOT
             KeyBindings: a window-level KeyBinding fires even while a TextBox has focus, so typing
             "d" in the find bar or a form field would silently swap tools. They live in
             OnPreviewKeyDown instead, behind the IsTypingTarget() guard. -->
    </Window.InputBindings>

    <Window.Resources>
        <!-- Theme brushes are supplied by Services.ThemeManager from Themes/*.xaml. -->

        <Style x:Key="VisibleFocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Rectangle Margin="1" Stroke="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                   StrokeThickness="2" StrokeDashArray="2 1" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toolbar button -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocusVisual}"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                ToolTip="{TemplateBinding ToolTip}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarButtonAccent" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
        </Style>
        <Style x:Key="ToolbarButtonDanger" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Foreground" Value="{DynamicResource DangerRed}"/>
        </Style>
        <Style x:Key="ToolbarToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocusVisual}"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                ToolTip="{TemplateBinding ToolTip}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentGreenDim}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar PAGES / OUTLINES tab selector -->
        <Style x:Key="SidebarTabRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="0,0,0,2" Padding="6,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChromeCloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Foreground" Value="{DynamicResource DangerRed}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerRed}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin green scrollbar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="thumbBorder"
                                                                    Background="{DynamicResource AccentGreenDim}"
                                                                    CornerRadius="3"
                                                                    Margin="1,0"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource AccentGreen}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="6"/>
                    <Setter Property="MinHeight" Value="6"/>
                    <Setter Property="Width" Value="Auto"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark context menu -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDim}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="4">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ======================================================== -->
        <!-- MenuItem — role-aware dark templates                    -->
        <!--                                                          -->
        <!-- A single <Setter Property="Template"> can't model the    -->
        <!-- four MenuItem.Role values, and the previous template     -->
        <!-- shipped without a Popup, so submenus never opened and    -->
        <!-- access-key underscores ("_File") rendered literally.     -->
        <!-- This style defines a template per role and uses          -->
        <!-- RecognizesAccessKey on every header ContentPresenter.    -->
        <!-- ======================================================== -->

        <!-- Popup shell shared by TopLevelHeader and SubmenuHeader -->
        <ControlTemplate x:Key="SubmenuPopupTemplate" TargetType="MenuItem">
            <Grid>
                <Border x:Name="HeaderBd"
                        Background="{TemplateBinding Background}"
                        Padding="12,4" CornerRadius="3">
                    <ContentPresenter ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center"/>
                </Border>
                <Popup x:Name="PART_Popup"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Fade">
                    <Border Background="{DynamicResource BgPanel}"
                            BorderBrush="{DynamicResource BorderDim}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="4"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
                        </Border.Effect>
                        <ScrollViewer Style="{x:Null}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="HeaderBd" Property="Background" Value="{DynamicResource BgHover}"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="HeaderBd" Property="Background" Value="{DynamicResource BgHover}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- SubmenuHeader template is defined inline in the Style.Triggers below. -->

        <!-- Shared look for the MDL2 glyph that sits in a menu row's left gutter. Set as
             MenuItem.Icon (a real TextBlock, never a bare string) so the icon column renders it
             natively; MakeMenuItem in MainWindow.xaml.cs builds the code-side equivalent. -->
        <Style x:Key="MenuGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        </Style>

        <!-- #177: the two halves of a shortcuts-overlay row. Rows are 2-column Grids (a fixed key
             column, the description taking the rest), both cells wrapping and vertically centred
             so a long description folds onto a second line without knocking its key out of line.
             Kept as styles so the ~40 rows below stay one line each. -->
        <Style x:Key="KsKeys" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="KsDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <!-- Left padding is small because the 20px icon/check gutter below supplies the indent. -->
            <Setter Property="Padding" Value="6,6,40,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <!-- Default Template = SubmenuItem (leaf rows inside a popup) -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuBd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Icon / check gutter, always reserved so every row's header
                                         starts at the same x whether or not it carries a glyph. -->
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="IconPresenter" Grid.Column="0"
                                                  ContentSource="Icon"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <!-- Check state for IsChecked rows (OCR languages, Invert Colors).
                                     Shares the gutter with the icon; the check wins when both apply. -->
                                <TextBlock x:Name="CheckGlyph" Grid.Column="0" Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{DynamicResource AccentGreen}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                           Foreground="{DynamicResource TextSecondary}" FontSize="11"
                                           VerticalAlignment="Center" Margin="24,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuBd" Property="Background" Value="{DynamicResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Top-level menu bar item with submenu (File, Edit, View, …) -->
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Padding" Value="12,4"/>
                    <Setter Property="Template" Value="{StaticResource SubmenuPopupTemplate}"/>
                </Trigger>
                <!-- Top-level menu bar item without a submenu -->
                <Trigger Property="Role" Value="TopLevelItem">
                    <Setter Property="Padding" Value="12,4"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="HeaderBd"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}" CornerRadius="3">
                                    <ContentPresenter ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="HeaderBd" Property="Background" Value="{DynamicResource BgHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <!-- Submenu item that itself contains children -->
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Grid>
                                    <Border x:Name="HeaderBd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}" CornerRadius="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- Same 20px gutter as the leaf rows so a submenu
                                                     header's header text lines up with theirs. -->
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" ContentSource="Icon"
                                                              VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                              RecognizesAccessKey="True"
                                                              VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="&#xE76C;"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       VerticalAlignment="Center" Margin="16,0,0,0"/>
                                        </Grid>
                                    </Border>
                                    <Popup x:Name="PART_Popup"
                                           Placement="Right"
                                           IsOpen="{TemplateBinding IsSubmenuOpen}"
                                           AllowsTransparency="True"
                                           Focusable="False"
                                           PopupAnimation="Fade">
                                        <Border Background="{DynamicResource BgPanel}"
                                                BorderBrush="{DynamicResource BorderDim}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="4"
                                                SnapsToDevicePixels="True">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
                                            </Border.Effect>
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="HeaderBd" Property="Background" Value="{DynamicResource BgHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsSubmenuOpen" Value="True">
                                        <Setter TargetName="HeaderBd" Property="Background" Value="{DynamicResource BgHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource BorderDim}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,4"/>
        </Style>

        <!-- ======================================================== -->
        <!-- Dark ComboBox (zoom dropdown)                           -->
        <!-- ======================================================== -->

        <!-- Toggle button used inside the ComboBox template -->
        <Style x:Key="DarkComboToggle" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem inside the dark popup -->
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource AccentGreenDim}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource AccentGreenDim}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The ComboBox itself -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDim}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocusVisual}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Clickable area / border -->
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Selected item text (non-editable mode) -->
                                    <ContentPresenter x:Name="ContentSite"
                                                      Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="7,0,0,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"/>
                                    <!-- Editable text box (shown when IsEditable=True) -->
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Grid.Column="0"
                                             Margin="5,0,0,0"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimary}"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             VerticalAlignment="Center"
                                             IsReadOnly="{TemplateBinding IsReadOnly}"
                                             Visibility="Hidden"
                                             Focusable="True"
                                             SelectionBrush="{StaticResource AccentGreenDim}"
                                             SelectionTextBrush="{StaticResource AccentGreen}"
                                             CaretBrush="{StaticResource AccentGreen}"/>
                                    <!-- Chevron arrow -->
                                    <TextBlock Grid.Column="1"
                                               Text="&#xE70D;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="8"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                    <!-- Invisible toggle over the whole control -->
                                    <ToggleButton Grid.Column="0" Grid.ColumnSpan="2"
                                                  Style="{StaticResource DarkComboToggle}"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                              RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Grid>
                            </Border>
                            <!-- Dropdown popup -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   Placement="Bottom">
                                <Border Background="{DynamicResource BgPanel}"
                                        BorderBrush="{DynamicResource AccentGreenDim}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="2"
                                        MinWidth="{Binding ActualWidth,
                                                   RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="220">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Page list styles -->
        <Style x:Key="PageListBox" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDim}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocusVisual}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocusVisual}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding}"/>
            <Setter Property="AutomationProperties.HelpText" Value="PDF page item"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentGreenDim}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- General-purpose dark text button (use on non-icon buttons to bypass WPF default blue hover) -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDim}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             Editable outline / bookmark tree (#133, upstream KillerPDF v1.6.4)
             Ported to TDPdf theme brushes: AccentGreen (accent), AccentGreenDim
             (selection fill), TextMuted (expander at rest), BgHover (row hover).
             ============================================================ -->
        <Style x:Key="OutlineTreeStyle" TargetType="TreeView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- Outline tree expander triangle: themed (muted at rest, accent on hover), rotates on
             expand. Replaces the stock WPF toggle so no default-blue chrome bleeds through. -->
        <Style x:Key="OutlineExpander" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="16" Height="16">
                            <Path x:Name="Arrow" Width="6" Height="9"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5"
                                  Data="M0,0 L5,4.5 L0,9 Z"
                                  Fill="{DynamicResource TextMuted}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource AccentGreen}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Outline tree row: accent left-bar + tinted selection, themed hover, no WPF blue. -->
        <Style x:Key="OutlineItemStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Header row: spans toggle + label, carries the selection fill and left accent
                                 bar. In row 0 only, so its IsMouseOver excludes child rows (no ancestor hover). -->
                            <Border x:Name="Bd" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                    Background="Transparent" BorderBrush="Transparent"
                                    BorderThickness="2,0,0,0" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Grid.Column="0"
                                                  Style="{DynamicResource OutlineExpander}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press"/>
                                    <ContentPresenter x:Name="PART_Header" Grid.Column="1"
                                                      ContentSource="Header"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <!-- Children indented by one toggle width -->
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentGreenDim}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" KeyboardNavigation.TabNavigation="Continue">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border x:Name="CustomTitleBar" Grid.Row="0" Background="{DynamicResource TitleBarBackground}" BorderBrush="{DynamicResource BorderDim}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid x:Name="ChromeA11yLabels" Width="0" Height="0" IsHitTestVisible="False" Focusable="False" Opacity="0">
                    <TextBlock x:Name="MinimizeButtonLabel" Text="Minimize window"/>
                    <TextBlock x:Name="MaximizeButtonLabel" Text="Maximize or restore window"/>
                    <TextBlock x:Name="CloseWindowButtonLabel" Text="Close window"/>
                </Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <!-- Logo: app icon + wordmark, and the grip for the app-wide UI scale
                         (AppScale.cs). Rolling the wheel here grows or shrinks the chrome; the
                         title bar and footer are deliberately NOT scaled, so the logo never moves
                         out from under the cursor. The press is left unhandled so it still bubbles
                         to TitleBar_MouseLeftButtonDown for window drag / double-click maximize. -->
                    <Border x:Name="LogoBar" Background="Transparent" Padding="4,0"
                            VerticalAlignment="Stretch"
                            MouseWheel="LogoBar_MouseWheel"
                            AutomationProperties.Name="TDPdf app size"
                            AutomationProperties.HelpText="Scroll the mouse wheel over the logo to scale the menu, toolbar, tab strip, and sidebar between 70% and 250%. Ctrl+Shift+Plus and Ctrl+Shift+Minus do the same; Ctrl+Shift+0 resets.">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Resources/splash-logo.png"
                                   Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="TD" FontFamily="Segoe UI" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Pdf" FontFamily="Segoe UI" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AccentGreen}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="" x:Name="FileNameLabel" VerticalAlignment="Center" Margin="16,0,0,0"
                               Foreground="{DynamicResource TextSecondary}" FontFamily="Consolas" FontSize="11"
                               AutomationProperties.Name="Current file"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#x2015;" Click="MinimizeBtn_Click" Style="{StaticResource ChromeButton}"
                            KeyboardNavigation.TabIndex="0" AutomationProperties.Name="Minimize window"
                            AutomationProperties.HelpText="Minimizes TDPdf to the taskbar"
                            AutomationProperties.LabeledBy="{Binding ElementName=MinimizeButtonLabel}"/>
                    <Button Content="&#x25A1;" Click="MaximizeBtn_Click" Style="{StaticResource ChromeButton}"
                            KeyboardNavigation.TabIndex="1" AutomationProperties.Name="Maximize or restore window"
                            AutomationProperties.HelpText="Toggles between maximized and restored window size"
                            AutomationProperties.LabeledBy="{Binding ElementName=MaximizeButtonLabel}"/>
                    <Button Content="&#x2715;" Click="CloseBtn_Click" Style="{StaticResource ChromeCloseButton}"
                            KeyboardNavigation.TabIndex="2" AutomationProperties.Name="Close window"
                            AutomationProperties.HelpText="Closes TDPdf"
                            AutomationProperties.LabeledBy="{Binding ElementName=CloseWindowButtonLabel}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Menu bar -->
        <Menu x:Name="MainMenu" Grid.Row="1"
              Background="{DynamicResource PanelBackground}"
              Foreground="{DynamicResource TextPrimary}"
              BorderBrush="{DynamicResource BorderDim}"
              BorderThickness="0,0,0,1"
              Padding="4,0"
              KeyboardNavigation.TabNavigation="Continue"
              AutomationProperties.Name="Main menu">
            <!-- Every leaf row carries its toolbar glyph in the left gutter (the same 20px column
                 the check mark uses); see the MenuItem template above and MakeMenuItem for the
                 code-built context menus. -->
            <MenuItem Header="_File" SubmenuOpened="FileMenu_SubmenuOpened">
                <MenuItem Header="_New"             InputGestureText="Ctrl+N"       Click="New_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE7C3;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Open…"           InputGestureText="Ctrl+O"       Click="Open_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8DA;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Close"           InputGestureText="Ctrl+W"       Click="CloseFile_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE711;"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Save"            InputGestureText="Ctrl+S"       Click="SaveInPlace_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE105;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save _As…"        InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE74E;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save _Flattened…"                                  Click="SaveFlattened_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8B9;"/></MenuItem.Icon>
                </MenuItem>
                <!-- #149: enabled by FileMenu_SubmenuOpened only when the active document
                     needed a password (or carried owner restrictions) to open. -->
                <MenuItem x:Name="RemovePasswordMenuItem"
                          Header="Remove Pass_word…"                                Click="RemovePassword_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE785;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Export Tables to CSV…"                            Click="ExportTablesCsv_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8A5;"/></MenuItem.Icon>
                </MenuItem>
                <!-- #132: renders the chosen pages to PNG/JPEG through the same pipeline as the CLI's to-image command. -->
                <MenuItem Header="Export Pages as _Images…"                          Click="ExportImages_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE91B;"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Merge…"                                          Click="Merge_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE710;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="E_xtract Pages…"                                  Click="Split_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8B1;"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Print…"          InputGestureText="Ctrl+P"       Click="Print_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE749;"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Document _Info…"   InputGestureText="F12"          Click="DocumentInfo_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE946;"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="E_xit"            InputGestureText="Alt+F4"       Click="Exit_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE7E8;"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo"            InputGestureText="Ctrl+Z"       Click="Undo_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE7A7;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Redo"            InputGestureText="Ctrl+Y"       Click="Redo_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE7A6;"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Find…"           InputGestureText="Ctrl+F"       Command="{x:Static ApplicationCommands.Find}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE721;"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Delete Selected Pages"                           Click="Delete_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8C6;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Clear All Annotations"                           Click="ClearAnnotations_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xED62;"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_View">
                <!-- InputGestureText on this row and the two App Size rows below is REWRITTEN at
                     startup by ApplyLayoutShortcutLabels (#153): which character the zoom key
                     types depends on the keyboard layout, so a hardcoded US spelling would
                     advertise a chord that does nothing on a German or Nordic machine. -->
                <MenuItem x:Name="ZoomInMenuItem"
                          Header="Zoom _In"         InputGestureText="Ctrl+="       Command="{x:Static local:MainWindow.ZoomInRoutedCommand}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE948;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Zoom _Out"        InputGestureText="Ctrl+-"       Command="{x:Static local:MainWindow.ZoomOutRoutedCommand}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE949;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Reset Zoom"      InputGestureText="Ctrl+0"       Command="{x:Static local:MainWindow.ZoomResetRoutedCommand}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE72C;"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <!-- The gutter added in 1.19 gives this row a real check mark (SyncDocInvertUi sets
                     IsChecked), replacing the old header-text flip that stood in for missing state. -->
                <MenuItem x:Name="InvertColorsMenuItem"
                          Header="_Invert Colors"   InputGestureText="Ctrl+I"       Click="DocInvert_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE708;"/></MenuItem.Icon>
                </MenuItem>
                <!-- Night mode keeps pictures their real colors by default; this row (and the
                     moon's right-click menu, and Shift+N) restores the whole-page inversion —
                     which is what a scan needs, since there the page IS one image. -->
                <MenuItem x:Name="InvertImagesMenuItem"
                          Header="Invert I_mages Too" InputGestureText="Shift+N"    Click="DocInvertImages_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xEB9F;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Toggle _Sidebar"                                  Click="SidebarToggle_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE700;"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <!-- App size scales the CHROME only (menu, toolbar, tab strip, sidebar); the page
                     keeps its own zoom above. Also driven by the wheel over the title-bar logo. -->
                <MenuItem x:Name="AppSizeLargerMenuItem"
                          Header="App Size _Larger"  InputGestureText="Ctrl+Shift+=" Command="{x:Static local:MainWindow.AppScaleUpCommand}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8E8;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="AppSizeSmallerMenuItem"
                          Header="App Size Small_er" InputGestureText="Ctrl+Shift+-" Command="{x:Static local:MainWindow.AppScaleDownCommand}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8E7;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Reset App Si_ze"   InputGestureText="Ctrl+Shift+0" Command="{x:Static local:MainWindow.AppScaleResetCommand}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8E9;"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <!-- Tool rows advertise the 1.19 single-key shortcuts (see OnPreviewKeyDown). The digits
                 mirror the toolbar left to right; V / P and G / C are letter-only. -->
            <MenuItem Header="_Tools">
                <MenuItem Header="_Select"          InputGestureText="V"            Click="ToolSelect_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8B3;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Pan / Hand"      InputGestureText="P"            Click="ToolPan_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE7C9;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Text"            InputGestureText="1, T"         Click="ToolText_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8D2;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Edit Existing Te_xt" InputGestureText="2, X"      Click="ToolEditText_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE104;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Edit Existing _Image" InputGestureText="3"        Click="ToolEditImage_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xEB9F;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="I_nsert Image"    InputGestureText="4, I"         Click="ToolImage_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE91B;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Highlight"       InputGestureText="5, H"         Click="ToolHighlight_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xED56;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Stri_kethrough"   InputGestureText="6, K"         Click="ToolStrike_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xEDE0;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Underline"       InputGestureText="7, U"         Click="ToolUnderline_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE8DC;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Sh_ape"           InputGestureText="8, S"         Click="ToolShape_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xF158;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Draw"            InputGestureText="9, D"         Click="ToolDraw_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xED63;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Eraser"          InputGestureText="0, E"         Click="ToolErase_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE75C;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Si_gnature"       InputGestureText="G"            Click="ToolSignature_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xEE56;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Crop"            InputGestureText="C"            Click="ToolCrop_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE7A8;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Trans_form Page…"                                 Click="ToolTransform_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE90F;"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <!-- OCR submenu is rebuilt on open (OcrMenu_SubmenuOpened); the placeholder keeps the
                     submenu arrow visible so the event fires. -->
                <MenuItem Header="_OCR" SubmenuOpened="OcrMenu_SubmenuOpened">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xEE6F;"/></MenuItem.Icon>
                    <MenuItem Header="…"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Se_ttings…"                                       Click="Settings_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE713;"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="View on _GitHub"                                  Click="HelpGitHub_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE774;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Report an Issue"                                 Click="HelpReportIssue_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE7BA;"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="View _Changelog"                                  Click="HelpChangelog_Click">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE81C;"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_About TDPdf"     InputGestureText="F1"           Command="{x:Static local:MainWindow.AboutCommand}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuGlyph}" Text="&#xE897;"/></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <Border x:Name="ToolbarBorder" Grid.Row="2" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderDim}" BorderThickness="0,0,0,1" Padding="4,2"
                KeyboardNavigation.TabNavigation="Continue">
            <Grid>
                <Grid x:Name="ToolbarA11yLabels" Width="0" Height="0" IsHitTestVisible="False" Focusable="False" Opacity="0">
                    <TextBlock x:Name="OpenButtonLabel" Text="Open"/><TextBlock x:Name="CloseFileButtonLabel" Text="Close file"/>
                    <TextBlock x:Name="MergeButtonLabel" Text="Merge PDFs"/><TextBlock x:Name="SplitButtonLabel" Text="Extract pages"/>
                    <TextBlock x:Name="DeleteButtonLabel" Text="Delete selected pages"/><TextBlock x:Name="MoveUpButtonLabel" Text="Move page up"/>
                    <TextBlock x:Name="MoveDownButtonLabel" Text="Move page down"/><TextBlock x:Name="SaveAsButtonLabel" Text="Save as"/>
                    <TextBlock x:Name="SaveFlattenedButtonLabel" Text="Save flattened PDF"/><TextBlock x:Name="PrintButtonLabel" Text="Print"/>
                    <TextBlock x:Name="SelectToolButtonLabel" Text="Select tool"/><TextBlock x:Name="TextToolButtonLabel" Text="Text tool"/>
                    <TextBlock x:Name="HighlightToolButtonLabel" Text="Highlight tool"/><TextBlock x:Name="DrawToolButtonLabel" Text="Draw tool"/>
                    <TextBlock x:Name="StrikeToolButtonLabel" Text="Strikethrough tool"/><TextBlock x:Name="UnderlineToolButtonLabel" Text="Underline tool"/>
                    <TextBlock x:Name="SignatureButtonLabel" Text="Signature tool"/><TextBlock x:Name="CropToolButtonLabel" Text="Crop tool"/>
                    <TextBlock x:Name="EditTextToolButtonLabel" Text="Edit existing text tool"/><TextBlock x:Name="EditImageToolButtonLabel" Text="Edit existing image tool"/>
                    <TextBlock x:Name="UndoButtonLabel" Text="Undo last annotation"/><TextBlock x:Name="SettingsButtonLabel" Text="Settings"/>
                    <TextBlock x:Name="ClearAnnotationsButtonLabel" Text="Clear annotations"/><TextBlock x:Name="ZoomLabel" Text="Zoom level"/>
                </Grid>
                <!-- File operations -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="&#xE7C3;" Style="{StaticResource ToolbarButton}" Click="New_Click" ToolTip="New Blank Document (Ctrl+N)" KeyboardNavigation.TabIndex="3" AutomationProperties.Name="New blank document" AutomationProperties.HelpText="Create a single blank A4 page as a new document. Shortcut Ctrl+N." AutomationProperties.AccessKey="N"/>
                    <Button x:Name="OpenBtn" Content="&#xE8DA;" Style="{StaticResource ToolbarButton}" Click="Open_Click" MouseRightButtonUp="OpenBtn_RightButtonUp" ToolTip="Open (Ctrl+O, Alt+O) — right-click for recent files" KeyboardNavigation.TabIndex="4" AutomationProperties.Name="Open" AutomationProperties.HelpText="Open a PDF file. Shortcut Ctrl+O. Access key Alt+O. Right-click for recent files." AutomationProperties.AccessKey="O" AutomationProperties.LabeledBy="{Binding ElementName=OpenButtonLabel}"/>
                    <Button x:Name="CloseFileBtn" Content="&#xE711;" Style="{StaticResource ToolbarButton}" Click="CloseFile_Click" ToolTip="Close File (Ctrl+W, Alt+W)" IsEnabled="False" KeyboardNavigation.TabIndex="5" AutomationProperties.Name="Close file" AutomationProperties.HelpText="Close the current PDF and return to the start view. Shortcut Ctrl+W. Access key Alt+W." AutomationProperties.AccessKey="W" AutomationProperties.LabeledBy="{Binding ElementName=CloseFileButtonLabel}"/>
                    <Rectangle Width="1" Fill="{DynamicResource BorderDim}" Margin="4,6"/>
                    <Button Content="&#xE710;" Style="{StaticResource ToolbarButton}" Click="Merge_Click" ToolTip="Merge PDFs (Alt+M)" KeyboardNavigation.TabIndex="6" AutomationProperties.Name="Merge PDFs" AutomationProperties.HelpText="Combine additional PDFs into this document. Access key Alt+M." AutomationProperties.AccessKey="M" AutomationProperties.LabeledBy="{Binding ElementName=MergeButtonLabel}"/>
                    <Button Content="&#xE8B1;" Style="{StaticResource ToolbarButton}" Click="Split_Click" ToolTip="Extract Pages (Alt+E)" KeyboardNavigation.TabIndex="7" AutomationProperties.Name="Extract pages" AutomationProperties.HelpText="Save selected pages to a new PDF. Access key Alt+E." AutomationProperties.AccessKey="E" AutomationProperties.LabeledBy="{Binding ElementName=SplitButtonLabel}"/>
                    <Rectangle Width="1" Fill="{DynamicResource BorderDim}" Margin="4,6"/>
                    <Button Content="&#xE8C6;" Style="{StaticResource ToolbarButton}" Click="Delete_Click" ToolTip="Delete Selected Pages (Alt+D)" KeyboardNavigation.TabIndex="8" AutomationProperties.Name="Delete selected pages" AutomationProperties.HelpText="Delete the selected pages from the current PDF. Access key Alt+D." AutomationProperties.AccessKey="D" AutomationProperties.LabeledBy="{Binding ElementName=DeleteButtonLabel}"/>
                    <Rectangle Width="1" Fill="{DynamicResource BorderDim}" Margin="4,6"/>
                    <Button Content="&#xE74A;" Style="{StaticResource ToolbarButton}" Click="MoveUp_Click" ToolTip="Move Page Up (Alt+U)" KeyboardNavigation.TabIndex="9" AutomationProperties.Name="Move page up" AutomationProperties.HelpText="Move the selected page earlier in the document. Access key Alt+U." AutomationProperties.AccessKey="U" AutomationProperties.LabeledBy="{Binding ElementName=MoveUpButtonLabel}"/>
                    <Button Content="&#xE74B;" Style="{StaticResource ToolbarButton}" Click="MoveDown_Click" ToolTip="Move Page Down (Alt+N)" KeyboardNavigation.TabIndex="10" AutomationProperties.Name="Move page down" AutomationProperties.HelpText="Move the selected page later in the document. Access key Alt+N." AutomationProperties.AccessKey="N" AutomationProperties.LabeledBy="{Binding ElementName=MoveDownButtonLabel}"/>
                    <Rectangle Width="1" Fill="{DynamicResource BorderDim}" Margin="4,6"/>
                    <Button x:Name="SaveAsBtn" Content="&#xE74E;" Style="{StaticResource ToolbarButtonAccent}" Click="SaveAs_Click" ToolTip="Save As (Ctrl+Shift+S, Alt+S)" KeyboardNavigation.TabIndex="11" AutomationProperties.Name="Save as" AutomationProperties.HelpText="Save the PDF with annotations to a new file. Shortcut Ctrl+Shift+S. Access key Alt+S." AutomationProperties.AccessKey="S" AutomationProperties.LabeledBy="{Binding ElementName=SaveAsButtonLabel}"/>
                    <Button Content="&#xE8B9;" Style="{StaticResource ToolbarButton}" Click="SaveFlattened_Click" ToolTip="Save Flattened PDF (Alt+F)" KeyboardNavigation.TabIndex="12" AutomationProperties.Name="Save flattened PDF" AutomationProperties.HelpText="Rasterize all pages and save a fully uneditable PDF. Access key Alt+F." AutomationProperties.AccessKey="F" AutomationProperties.LabeledBy="{Binding ElementName=SaveFlattenedButtonLabel}"/>
                    <Button Content="&#xE749;" Style="{StaticResource ToolbarButton}" Click="Print_Click" ToolTip="Print (Ctrl+P, Alt+P)" KeyboardNavigation.TabIndex="13" AutomationProperties.Name="Print" AutomationProperties.HelpText="Print the current PDF. Shortcut Ctrl+P. Access key Alt+P." AutomationProperties.AccessKey="P" AutomationProperties.LabeledBy="{Binding ElementName=PrintButtonLabel}"/>
                    <Button Content="&#xE713;" Style="{StaticResource ToolbarButton}" Click="Settings_Click" ToolTip="Settings" KeyboardNavigation.TabIndex="27" AutomationProperties.Name="Settings" AutomationProperties.HelpText="Open theme and window frame settings." AutomationProperties.LabeledBy="{Binding ElementName=SettingsButtonLabel}"/>
                </StackPanel>
                <!-- Edit tools + zoom.
                     Each tool advertises its 1.19 single-key shortcut alongside the Alt access key,
                     in the same "(key, Alt+key)" style the file buttons use. The digits mirror this
                     strip left to right — 1 at the Text tool through 0 at the Eraser — while Select,
                     Pan, Signature and Crop are letter-only (see OnPreviewKeyDown). -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ToolSelectBtn" Content="&#xE8B3;" Style="{StaticResource ToolbarButton}" Click="ToolSelect_Click" ToolTip="Select Tool (V, Alt+Q)" KeyboardNavigation.TabIndex="14" AutomationProperties.Name="Select tool" AutomationProperties.HelpText="Select annotations, drag to select text, or double-click text to edit. Shortcut V. Access key Alt+Q." AutomationProperties.AccessKey="Q" AutomationProperties.LabeledBy="{Binding ElementName=SelectToolButtonLabel}"/>
                    <Button x:Name="ToolPanBtn" Content="&#xE7C9;" Style="{StaticResource ToolbarButton}" Click="ToolPan_Click" ToolTip="Pan / Hand Tool (P) — drag the page; middle-click to pan in any tool" KeyboardNavigation.TabIndex="14" AutomationProperties.Name="Pan tool" AutomationProperties.HelpText="Drag the page to scroll. Middle-mouse drag also pans while any tool is active. Shortcut P."/>
                    <Button x:Name="ToolTextBtn" Content="&#xE8D2;" Style="{StaticResource ToolbarButton}" Click="ToolText_Click" ToolTip="Text Tool (1 or T, Alt+T)" KeyboardNavigation.TabIndex="15" AutomationProperties.Name="Text tool" AutomationProperties.HelpText="Click the page to add text. Shortcut 1 or T. Access key Alt+T." AutomationProperties.AccessKey="T" AutomationProperties.LabeledBy="{Binding ElementName=TextToolButtonLabel}"/>
                    <Button x:Name="ToolEditTextBtn" Content="&#xE104;" Style="{StaticResource ToolbarButton}" Click="ToolEditText_Click" ToolTip="Edit Existing Text (2 or X)" KeyboardNavigation.TabIndex="16" AutomationProperties.Name="Edit existing text tool" AutomationProperties.HelpText="Click a PDF text run to white-out and redraw it. Shortcut 2 or X." AutomationProperties.LabeledBy="{Binding ElementName=EditTextToolButtonLabel}"/>
                    <Button x:Name="ToolEditImageBtn" Content="&#xEB9F;" Style="{StaticResource ToolbarButton}" Click="ToolEditImage_Click" ToolTip="Edit Existing Image (3)" KeyboardNavigation.TabIndex="17" AutomationProperties.Name="Edit existing image tool" AutomationProperties.HelpText="Click a PDF image to replace, delete, or resize it. Shortcut 3." AutomationProperties.LabeledBy="{Binding ElementName=EditImageToolButtonLabel}"/>
                    <Button x:Name="ToolImageBtn" Content="&#xE91B;" Style="{StaticResource ToolbarButton}" Click="ToolImage_Click" ToolTip="Insert Image (4 or I, Alt+I)" KeyboardNavigation.TabIndex="18" AutomationProperties.Name="Insert image tool" AutomationProperties.HelpText="Click the page to insert a PNG/JPG/BMP/GIF/TIFF as a resizable annotation. Shortcut 4 or I. Access key Alt+I." AutomationProperties.AccessKey="I"/>
                    <Button x:Name="ToolHighlightBtn" Content="&#xED56;" Style="{StaticResource ToolbarButton}" Click="ToolHighlight_Click" ToolTip="Highlight Tool (5 or H, Alt+H)" KeyboardNavigation.TabIndex="19" AutomationProperties.Name="Highlight tool" AutomationProperties.HelpText="Drag on the page to add a highlight. Shortcut 5 or H. Access key Alt+H." AutomationProperties.AccessKey="H" AutomationProperties.LabeledBy="{Binding ElementName=HighlightToolButtonLabel}"/>
                    <Button x:Name="ToolStrikeBtn" Content="&#xEDE0;" Style="{StaticResource ToolbarButton}" Click="ToolStrike_Click" ToolTip="Strikethrough (6 or K) — drag across text" KeyboardNavigation.TabIndex="19" AutomationProperties.Name="Strikethrough tool" AutomationProperties.HelpText="Drag across words on the page to strike them through. The markup follows the text, hugging each line. Shortcut 6 or K." AutomationProperties.LabeledBy="{Binding ElementName=StrikeToolButtonLabel}"/>
                    <Button x:Name="ToolUnderlineBtn" Content="&#xE8DC;" Style="{StaticResource ToolbarButton}" Click="ToolUnderline_Click" ToolTip="Underline (7 or U) — drag across text" KeyboardNavigation.TabIndex="19" AutomationProperties.Name="Underline tool" AutomationProperties.HelpText="Drag across words on the page to underline them. The markup follows the text, hugging each line. Shortcut 7 or U." AutomationProperties.LabeledBy="{Binding ElementName=UnderlineToolButtonLabel}"/>
                    <Button x:Name="ToolShapeBtn" Content="&#xF158;" Style="{StaticResource ToolbarButton}" Click="ToolShape_Click" ToolTip="Shape Tool (8 or S) — rectangle / ellipse / line / freeform polygon with stroke and fill" KeyboardNavigation.TabIndex="19" AutomationProperties.Name="Shape tool" AutomationProperties.HelpText="Drag on the page to draw a rectangle, ellipse, or line, or pick the polygon sub-mode and click to place each point. Shortcut 8 or S."/>
                    <Button x:Name="ToolDrawBtn" Content="&#xED63;" Style="{StaticResource ToolbarButton}" Click="ToolDraw_Click" ToolTip="Draw Tool (9 or D, Alt+R)" KeyboardNavigation.TabIndex="20" AutomationProperties.Name="Draw tool" AutomationProperties.HelpText="Draw freehand ink on the page. Shortcut 9 or D. Access key Alt+R." AutomationProperties.AccessKey="R" AutomationProperties.LabeledBy="{Binding ElementName=DrawToolButtonLabel}"/>
                    <Button x:Name="ToolEraseBtn" Content="&#xE75C;" Style="{StaticResource ToolbarButton}" Click="ToolErase_Click" ToolTip="Eraser (0 or E) — click an annotation to remove it" KeyboardNavigation.TabIndex="20" AutomationProperties.Name="Eraser tool" AutomationProperties.HelpText="Click an annotation to delete it. Shortcut 0 or E."/>
                    <Rectangle Width="1" Fill="{DynamicResource BorderDim}" Margin="4,6"/>
                    <Button x:Name="ToolSignatureBtn" Content="&#xEE56;" Style="{StaticResource ToolbarButton}" Click="ToolSignature_Click" ToolTip="Signature (G, Alt+G)" KeyboardNavigation.TabIndex="21" AutomationProperties.Name="Signature tool" AutomationProperties.HelpText="Create and place signatures. Shortcut G. Access key Alt+G." AutomationProperties.AccessKey="G" AutomationProperties.LabeledBy="{Binding ElementName=SignatureButtonLabel}"/>
                    <Button x:Name="ToolCropBtn" Content="&#xE7A8;" Style="{StaticResource ToolbarButton}" Click="ToolCrop_Click" ToolTip="Crop pages (C, Alt+C)" KeyboardNavigation.TabIndex="22" AutomationProperties.Name="Crop tool" AutomationProperties.HelpText="Drag a rectangle on the page, then apply the crop. Shortcut C. Access key Alt+C." AutomationProperties.AccessKey="C" AutomationProperties.LabeledBy="{Binding ElementName=CropToolButtonLabel}"/>
                    <Rectangle Width="1" Fill="{DynamicResource BorderDim}" Margin="4,6"/>
                    <Button Content="&#xE7A7;" Style="{StaticResource ToolbarButton}" Click="Undo_Click" ToolTip="Undo Last (Ctrl+Z, Alt+Z)" KeyboardNavigation.TabIndex="23" AutomationProperties.Name="Undo last annotation" AutomationProperties.HelpText="Undo the last annotation change. Shortcut Ctrl+Z. Access key Alt+Z." AutomationProperties.AccessKey="Z" AutomationProperties.LabeledBy="{Binding ElementName=UndoButtonLabel}"/>
                    <Button Content="&#xED62;" Style="{StaticResource ToolbarButtonDanger}" Click="ClearAnnotations_Click" ToolTip="Clear All Annotations (Alt+L)" KeyboardNavigation.TabIndex="24" AutomationProperties.Name="Clear all annotations" AutomationProperties.HelpText="Clear all annotations on the current page. Access key Alt+L." AutomationProperties.AccessKey="L" AutomationProperties.LabeledBy="{Binding ElementName=ClearAnnotationsButtonLabel}"/>
                    <Rectangle Width="1" Fill="{DynamicResource BorderDim}" Margin="4,6"/>
                    <ToggleButton x:Name="GridViewToggle"
                                  Content="&#xE8A9;"
                                  Style="{StaticResource ToolbarToggleButton}"
                                  IsChecked="True"
                                  IsEnabled="False"
                                  Click="GridViewToggle_Click"
                                  ToolTip="Multi-page grid view"
                                  Margin="0,0,4,0"
                                  AutomationProperties.Name="Multi-page grid view"
                                  AutomationProperties.HelpText="Toggle the multi-page grid preview. When off, only the current page is rendered."/>
                    <Button Content="&#xE949;" Style="{StaticResource ToolbarButton}" Click="ZoomOut_Click" ToolTip="Zoom Out (Ctrl+-)" KeyboardNavigation.TabIndex="25" AutomationProperties.Name="Zoom out" AutomationProperties.HelpText="Decrease the page zoom level. Shortcut Control minus."/>
                    <ComboBox x:Name="ZoomBox" Width="104" Height="24" VerticalAlignment="Center" Margin="0,0,4,0" IsEditable="True" IsReadOnly="True" Style="{StaticResource DarkComboBox}" KeyboardNavigation.TabIndex="26" AutomationProperties.Name="Zoom level" AutomationProperties.HelpText="Choose the page zoom level. Use Control plus mouse wheel to zoom." AutomationProperties.LabeledBy="{Binding ElementName=ZoomLabel}"
                              ItemsSource="{Binding Zoom.AvailableLevels, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="DisplayText"
                              SelectedItem="{Binding Zoom.SelectedLevel, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                              Text="{Binding Zoom.DisplayText, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                              SelectionChanged="ZoomBox_SelectionChanged" ToolTip="Zoom level (Ctrl+scroll to zoom)"/>
                    <Button x:Name="ZoomInButton" Content="&#xE948;" Style="{StaticResource ToolbarButton}" Click="ZoomIn_Click" ToolTip="Zoom In (Ctrl+=)" KeyboardNavigation.TabIndex="28" AutomationProperties.Name="Zoom in" AutomationProperties.HelpText="Increase the page zoom level. Shortcut Control plus."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <!-- Document tab strip — shown only when more than one PDF is open -->
        <Border x:Name="TabStripBorder" Grid.Row="3" Visibility="Collapsed"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource BorderDim}" BorderThickness="0,0,0,1"
                Padding="8,0,8,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="TabStrip" Orientation="Horizontal"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4" x:Name="MainContentGrid" KeyboardNavigation.TabNavigation="Continue">
            <Grid.ColumnDefinitions>
                <!-- SidebarCol never collapses to 0 — it shrinks to 24px (the toggle strip width). -->
                <ColumnDefinition x:Name="SidebarCol" Width="180" MinWidth="24" MaxWidth="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar column: inner grid splits content from permanent toggle strip.
                 Named because the app-wide UI scale (AppScale.cs) hangs its LayoutTransform here —
                 the SidebarCol width sites convert through SbPx so the collapse/expand glide keeps
                 working at any scale. -->
            <Grid x:Name="SidebarOuterGrid" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>        <!-- page list content -->
                    <ColumnDefinition Width="24"/>       <!-- toggle strip — always visible -->
                </Grid.ColumnDefinitions>

                <!-- Page list content (hidden when collapsed) -->
                <Border x:Name="SidebarBorder" Grid.Column="0"
                        Background="{DynamicResource SidebarBackground}"
                        BorderBrush="{DynamicResource BorderDim}" BorderThickness="0,0,0,0">
                    <!-- SidebarContentPanel is pinned to a fixed width for the duration of a
                         collapse/expand glide (SetSidebarCollapsed) so the shrinking border clips
                         the thumbnails instead of squeezing them. Normal layout is Stretch. -->
                    <DockPanel x:Name="SidebarContentPanel">
                        <!-- PAGES / OUTLINES tab selector -->
                        <Grid x:Name="SidebarTabRow" DockPanel.Dock="Top" Margin="8,8,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="SidebarPagesTab" Grid.Column="0" Content="PAGES"
                                         GroupName="SidebarTabs" IsChecked="True"
                                         Style="{StaticResource SidebarTabRadio}"
                                         Checked="SidebarPagesTab_Checked"
                                         AutomationProperties.Name="Show page thumbnails"/>
                            <RadioButton x:Name="SidebarOutlinesTab" Grid.Column="1" Content="OUTLINES"
                                         GroupName="SidebarTabs" IsEnabled="False"
                                         Style="{StaticResource SidebarTabRadio}"
                                         Checked="SidebarOutlinesTab_Checked"
                                         AutomationProperties.Name="Show document outline"/>
                        </Grid>
                        <!-- Sticky header — stays put when the page list scrolls -->
                        <DockPanel x:Name="PageControlsRow" DockPanel.Dock="Top" LastChildFill="False" Margin="12,8,8,4">
                            <TextBlock x:Name="PagesHeader" Text="PAGES" DockPanel.Dock="Left"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <!-- The page total and jump box start hidden: with no document open
                                 there is no page count, and an empty box next to "/ –" is noise.
                                 UpdatePageControlsForDoc reveals them when a document is up. -->
                            <TextBlock x:Name="PageTotalLabel" DockPanel.Dock="Right"
                                       Text="/ –" VerticalAlignment="Center" Visibility="Collapsed"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="2,0,0,0"/>
                            <TextBox x:Name="PageJumpBox" DockPanel.Dock="Right" Visibility="Collapsed"
                                     Width="36" Height="20" VerticalAlignment="Center"
                                     TextAlignment="Center" VerticalContentAlignment="Center"
                                     FontFamily="Consolas" FontSize="11"
                                     Background="{DynamicResource BgPanel}"
                                     Foreground="{DynamicResource TextPrimary}"
                                     BorderBrush="{DynamicResource BorderDim}" BorderThickness="1"
                                     CaretBrush="{DynamicResource AccentGreen}"
                                     SelectionBrush="{DynamicResource AccentGreenDim}"
                                     IsEnabled="False"
                                     FocusVisualStyle="{x:Null}"
                                     KeyDown="PageJumpBox_KeyDown"
                                     GotFocus="PageJumpBox_GotFocus"
                                     ToolTip="Go to page (Enter to navigate)"
                                     AutomationProperties.Name="Go to page"
                                     Margin="0,0,2,0">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderDim}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </DockPanel>
                        <Grid>
                            <ScrollViewer x:Name="SidebarScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ListBox x:Name="PageList" Style="{StaticResource PageListBox}"
                                         BorderThickness="0" SelectionMode="Extended"
                                         KeyboardNavigation.TabIndex="30"
                                         AutomationProperties.Name="Pages"
                                         AutomationProperties.HelpText="List of pages in the current PDF. Select pages to preview, reorder, extract, or delete. Right-click for page operations."
                                         AutomationProperties.LabeledBy="{Binding ElementName=PagesHeader}"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseWheel="PageList_PreviewMouseWheel"
                                         SelectionChanged="PageList_SelectionChanged"
                                         AllowDrop="True" Drop="PageList_Drop" DragOver="PageList_DragOver"
                                         PreviewMouseLeftButtonDown="PageList_PreviewMouseLeftButtonDown"
                                         PreviewMouseMove="PageList_PreviewMouseMove"
                                         MouseRightButtonUp="PageList_MouseRightButtonUp"/>
                            </ScrollViewer>
                            <ScrollViewer x:Name="OutlineScrollViewer" Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          PreviewMouseWheel="OutlineScroll_PreviewMouseWheel">
                                <TreeView x:Name="OutlineTree"
                                          BorderThickness="0" Padding="0,2"
                                          Background="Transparent"
                                          Style="{StaticResource OutlineTreeStyle}"
                                          ItemContainerStyle="{StaticResource OutlineItemStyle}"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          VirtualizingStackPanel.IsVirtualizing="False"
                                          SelectedItemChanged="OutlineTree_SelectedItemChanged"
                                          PreviewMouseLeftButtonDown="OutlineTree_PreviewMouseLeftButtonDown"
                                          PreviewMouseRightButtonDown="OutlineTree_PreviewMouseRightButtonDown"
                                          PreviewKeyDown="OutlineTree_PreviewKeyDown"
                                          AutomationProperties.Name="Document outline"
                                          AutomationProperties.HelpText="Bookmarks in the current PDF. Select an entry to jump to that page. On editable files, right-click to add, rename, reorder, or delete bookmarks."/>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>

                </Border>

                <!-- Toggle strip — always 24px wide, right edge of sidebar column -->
                <Border Grid.Column="1"
                        Background="{DynamicResource BgDark}"
                        BorderBrush="{DynamicResource BorderDim}"
                        BorderThickness="1,0,0,0">
                    <Grid>
                        <Button x:Name="SidebarToggleBtn"
                                Content="&#xE76B;" ToolTip="Collapse sidebar"
                                Style="{StaticResource ToolbarButton}"
                                Width="24" Padding="0" FontSize="10"
                                VerticalAlignment="Top" Margin="0,6,0,0"
                                Click="SidebarToggle_Click"/>
                        <!-- #135: invert document colors. Moon glyph (MDL2 QuietHours); the icon
                             lights in the accent while active, driven by Tag="on" from
                             SyncDocInvertUi so all three themes repaint live. ToolTip and
                             AutomationProperties.HelpText are filled there too (they change with
                             the state), matching how the toolbar buttons state the hint twice.
                             Right-click opens the night-mode options (the "invert images too"
                             carve-out); that ContextMenu is attached in BuildDocInvertRailMenu. -->
                        <Button x:Name="InvertColorsBtn"
                                Content="&#xE708;"
                                Width="24" Height="24" Padding="0" FontSize="13"
                                VerticalAlignment="Bottom" Margin="0,0,0,6"
                                Click="DocInvert_Click"
                                AutomationProperties.Name="Invert document colors">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                                    <Style.Triggers>
                                        <Trigger Property="Tag" Value="on">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Preview area -->
            <Border Grid.Column="1" Background="{DynamicResource BgDark}">
                <Grid>
                    <TextBlock x:Name="DropZoneLabel" Text="Open PDF drop zone" Width="0" Height="0" Opacity="0" IsHitTestVisible="False" Focusable="False"/>
                    <TextBlock x:Name="PagePreviewLabel" Text="PDF page preview" Width="0" Height="0" Opacity="0" IsHitTestVisible="False" Focusable="False"/>
                    <TextBlock x:Name="AnnotationCanvasLabel" Text="PDF annotation canvas" Width="0" Height="0" Opacity="0" IsHitTestVisible="False" Focusable="False"/>
                    <!-- Drop zone -->
                    <Border x:Name="DropZone" Background="Transparent" Focusable="True" KeyboardNavigation.TabIndex="40" AutomationProperties.Name="Open PDF drop zone" AutomationProperties.HelpText="Drop PDFs, images, folders, or .zip archives here, or press Enter or Space to browse for a PDF." AutomationProperties.LabeledBy="{Binding ElementName=DropZoneLabel}" AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" KeyDown="DropZone_KeyDown" MouseLeftButtonDown="DropZone_Click">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border BorderBrush="{DynamicResource BorderDim}" BorderThickness="2" CornerRadius="8" Margin="40,40,40,12" Padding="40" HorizontalAlignment="Center" Background="Transparent" Style="{x:Null}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Drop PDF here" FontFamily="Segoe UI" FontSize="20" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="or click to browse" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource BorderDim}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    <TextBlock Text="PDFs, images, folders, and .zip archives" FontFamily="Segoe UI" FontSize="11" Foreground="{DynamicResource BorderDim}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <!-- Recent files (hidden when there are none) -->
                            <Border x:Name="RecentFilesBox" Visibility="Collapsed" Width="440" Margin="40,0,40,40"
                                    Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderDim}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <Grid Margin="4,0,4,6">
                                        <TextBlock Text="Recent files" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                        <Button x:Name="ClearRecentBtn" Content="Clear recent files" Click="ClearRecent_Click"
                                                HorizontalAlignment="Right" Cursor="Hand" FontFamily="Segoe UI" FontSize="11"
                                                Foreground="{DynamicResource TextSecondary}" Background="Transparent"
                                                BorderThickness="0" Padding="4,1"
                                                AutomationProperties.Name="Clear recent files"
                                                AutomationProperties.HelpText="Remove every entry from the recent-files list.">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerRed}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                    <StackPanel x:Name="RecentFilesList"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- PDF page with annotation overlay -->
                    <ScrollViewer x:Name="PagePreviewPanel" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="Transparent" Focusable="True" KeyboardNavigation.TabIndex="40" AutomationProperties.Name="PDF page preview" AutomationProperties.HelpText="Scrollable preview of the selected PDF page." AutomationProperties.LabeledBy="{Binding ElementName=PagePreviewLabel}" PreviewMouseWheel="PagePreview_PreviewMouseWheel" SizeChanged="PagePreviewPanel_SizeChanged" AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver">
                        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Padding="12">
                            <Grid x:Name="PageContentGrid" IsManipulationEnabled="True" ManipulationDelta="PageContentGrid_ManipulationDelta">
                                <Grid.LayoutTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Grid.LayoutTransform>
                                <controls:SafeWrapPanel x:Name="PageContentPanel" Orientation="Horizontal">
                                    <!-- Primary page (always present) -->
                                    <Border Background="White" Margin="0,0,12,12">
                                        <Grid>
                                            <Image x:Name="PageImage" RenderOptions.BitmapScalingMode="HighQuality" Stretch="None" AutomationProperties.Name="Rendered PDF page"/>
                                            <Canvas x:Name="AnnotationCanvas" Background="Transparent" ClipToBounds="True" Focusable="True" KeyboardNavigation.TabIndex="41" AutomationProperties.Name="PDF annotation canvas" AutomationProperties.HelpText="Use the selected tool to add, select, edit, or delete annotations on the current page." AutomationProperties.LabeledBy="{Binding ElementName=AnnotationCanvasLabel}" PreviewMouseDown="Canvas_PreviewMouseDown" PreviewMouseLeftButtonDown="Canvas_MouseLeftButtonDown" MouseMove="Canvas_MouseMove" PreviewMouseLeftButtonUp="Canvas_MouseLeftButtonUp" PreviewMouseUp="Canvas_PreviewMouseUp" LostMouseCapture="Canvas_LostMouseCapture"/>
                                        </Grid>
                                    </Border>
                                    <!-- Additional pages rendered dynamically in code-behind -->
                                </controls:SafeWrapPanel>
                                <!-- Continuous-scroll strip: all pages stacked vertically.
                                     Shares PageContentGrid's ScaleTransform so zoom applies. -->
                                <StackPanel x:Name="ContinuousPanel" Orientation="Vertical"
                                            HorizontalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border x:Name="StatusBarBorder" Grid.Row="5" Background="{DynamicResource StatusBarBackground}" BorderBrush="{DynamicResource BorderDim}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0" KeyboardNavigation.TabNavigation="Continue">
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource TextSecondary}" FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center" AutomationProperties.Name="Status" AutomationProperties.HelpText="Current application status" AutomationProperties.LiveSetting="Polite"/>
                <!-- Portable mode indicator (hidden when installed) -->
                <StackPanel x:Name="PortableBadge" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="PORTABLE" Foreground="{DynamicResource TextMuted}"
                               FontFamily="Consolas" FontSize="9"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="InstallBtn" Content="Install TDPdf..."
                            Click="Install_Click"
                            FontFamily="Segoe UI" FontSize="10"
                            Foreground="{DynamicResource AccentGreen}"
                            Background="Transparent"
                            BorderThickness="1" BorderBrush="{DynamicResource AccentGreenDim}"
                            Padding="8,1" Cursor="Hand"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Install TDPdf"
                            AutomationProperties.HelpText="Install TDPdf to your user profile and relaunch from the installed location.">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="2" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentGreenDim}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- App-wide UI scale (AppScale.cs), deliberately sat next to the page-zoom
                         chip so the two sizes read as the pair they are: this one scales the
                         chrome, that one the page. Scroll to step, click to reset — the same
                         gestures as the title-bar logo, and reachable even when the custom title
                         bar is hidden (Settings ▸ native window frame). The footer itself is never
                         scaled, so this chip holds still under the cursor. -->
                    <Button x:Name="AppScaleButton" Content="UI 100%"
                             Style="{StaticResource DarkButton}" Padding="6,2" Margin="0,0,12,0"
                             FontFamily="Consolas" FontSize="10"
                             Click="AppScaleReset_Click" MouseWheel="LogoBar_MouseWheel"
                             ToolTip="App size — scroll to resize the menu, toolbar, tab strip and sidebar; click to reset to 100% (Ctrl+Shift+0)"
                             AutomationProperties.Name="App size"
                             AutomationProperties.HelpText="Scales the application chrome between 70 and 250 percent. Scroll the mouse wheel to change it, or press Control Shift Plus and Control Shift Minus. Click to reset. The document page keeps its own zoom."/>
                    <Button x:Name="StatusZoomButton" Content="{Binding Zoom.DisplayText, RelativeSource={RelativeSource AncestorType=Window}}"
                             Style="{StaticResource DarkButton}" Padding="6,2" Margin="0,0,12,0"
                             FontFamily="Consolas" FontSize="10"
                             Click="ResetZoom_Click" ToolTip="Reset zoom to 100% (Ctrl+0)" AutomationProperties.Name="Current zoom" AutomationProperties.HelpText="Reset zoom to 100 percent. Shortcut Control zero."/>
                    <Button Click="ShortcutHelp_Click"
                            Cursor="Hand" VerticalAlignment="Center"
                            Margin="0,0,12,0" FocusVisualStyle="{x:Null}"
                            ToolTip="Keyboard shortcuts (Ctrl+?)"
                            AutomationProperties.Name="Keyboard shortcuts"
                            AutomationProperties.HelpText="Show the keyboard shortcut overlay. Shortcut Control question mark.">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock Text="?"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontFamily="Consolas" FontSize="10"
                                           VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock x:Name="VersionLabel" Text="v1.2.0.0" Foreground="{DynamicResource TextMuted}" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="Application version"/>
                    <TextBlock FontSize="10" VerticalAlignment="Center" FontFamily="Consolas">
                        <Run Text="&#x00A9; 2026 " Foreground="{DynamicResource TextMuted}"/>
                        <Hyperlink NavigateUri="https://thedoodleproject.com/tdpdf" RequestNavigate="Hyperlink_RequestNavigate" KeyboardNavigation.TabIndex="50" AutomationProperties.Name="The Doodle Project website" AutomationProperties.HelpText="Opens The Doodle Project website" Foreground="{DynamicResource TextMuted}" TextDecorations="None">
                            <Run Text="The Doodle Project"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Keyboard shortcut overlay -->
        <Grid x:Name="ShortcutOverlay"
              Grid.RowSpan="6"
              Panel.ZIndex="10000"
              Visibility="Collapsed"
              Background="#BB000000"
              MouseLeftButtonDown="ShortcutOverlay_MouseLeftButtonDown">
            <Border x:Name="ShortcutCard"
                    Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource AccentGreen}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="28,16,28,22"
                    Margin="48,32,48,32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    MaxWidth="900"
                    MouseLeftButtonDown="ShortcutOverlayCard_MouseLeftButtonDown">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Keyboard Shortcuts"
                                   FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <!-- LIST / KEYBOARD view toggle (upstream KillerPDF v1.6.4). -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="KsViewListBtn" Content="LIST" Click="KsViewList_Click"
                                    Cursor="Hand" FocusVisualStyle="{x:Null}"
                                    FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                    Foreground="{DynamicResource AccentGreen}"
                                    AutomationProperties.Name="Show shortcuts as a list">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter Margin="6,2"/>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock Text="/" VerticalAlignment="Center" Margin="2,0"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"/>
                            <Button x:Name="KsViewKeyboardBtn" Content="KEYBOARD" Click="KsViewKeyboard_Click"
                                    Cursor="Hand" FocusVisualStyle="{x:Null}"
                                    FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    AutomationProperties.Name="Show shortcuts on a keyboard">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter Margin="6,2"/>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <Button Click="ShortcutOverlayClose_Click"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Cursor="Hand" FocusVisualStyle="{x:Null}"
                                Width="24" Height="24"
                                AutomationProperties.Name="Close keyboard shortcuts">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock Text="&#xE711;"
                                               FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Grid x:Name="ShortcutListHost">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FILE" Foreground="{DynamicResource AccentGreen}"
                                       FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="Ctrl+O"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Open"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="Ctrl+W"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Close file"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="Ctrl+N"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="New blank document"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="Ctrl+S"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Save"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="Ctrl+Shift+S"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Save As"/></Grid>
                            <Grid Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="Ctrl+P"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Print"/></Grid>

                            <TextBlock Text="NAVIGATION" Foreground="{DynamicResource AccentGreen}"
                                       FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Margin="0,12,0,4"/>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="&#x2190; / &#x2192; or &#x2191; / &#x2193;"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Previous / next page"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="Ctrl+Scroll"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Zoom in / out"/></Grid>
                            <Grid Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="Middle drag"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Pan view"/></Grid>

                            <TextBlock Text="VIEW" Foreground="{DynamicResource AccentGreen}"
                                       FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Margin="0,12,0,4"/>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="Ctrl+I"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Invert colors (display only)"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="Shift+N"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Invert images too (for scans)"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="KsAppSizeKeys" Style="{StaticResource KsKeys}" Text="Ctrl+Shift++ / -"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="App size larger / smaller"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="Ctrl+Shift+0"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Reset app size"/></Grid>
                            <Grid Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="Scroll on logo"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="App size (chrome only)"/></Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="EDITING" Foreground="{DynamicResource AccentGreen}"
                                       FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="Ctrl+Z"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Undo"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="Delete"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Delete selected annotation"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="Enter / Escape"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Confirm / cancel text or crop"/></Grid>

                            <TextBlock Text="SEARCH &amp; SELECT" Foreground="{DynamicResource AccentGreen}"
                                       FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Margin="0,12,0,4"/>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="Ctrl+F"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Find / search"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="Enter / Shift+Enter"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Next / previous result"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="Ctrl+A"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Select all text on page"/></Grid>
                            <Grid Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="Ctrl+C"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Copy selected text"/></Grid>

                            <!-- Tool keys (1.19). Unmodified keys, live only while a document is open
                                 and the keyboard focus is not in a text box. The digits mirror the
                                 toolbar left to right; Select / Pan / Signature / Crop are letter-only. -->
                            <TextBlock Text="TOOLS" Foreground="{DynamicResource AccentGreen}"
                                       FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Margin="0,12,0,4"/>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="V"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Select"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="P"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Pan / hand"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="1 / T"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Text"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="2 / X"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Edit existing text"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="3"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Edit existing image"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="4 / I"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Insert image"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="5 / H"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Highlight"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="6 / K"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Strikethrough"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="7 / U"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Underline"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="8 / S"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Shape"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="9 / D"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Draw"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="0 / E"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Eraser"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="G"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Signature"/></Grid>
                            <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="C"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Crop"/></Grid>
                            <Grid Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="Escape"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="Step back to the Select tool"/></Grid>

                            <TextBlock Text="HELP" Foreground="{DynamicResource AccentGreen}"
                                       FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Margin="0,12,0,4"/>
                            <Grid Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource KsKeys}" Text="Ctrl+?"/><TextBlock Grid.Column="1" Style="{StaticResource KsDesc}" Text="This shortcut list"/></Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Rendered visual keyboard; built lazily in KeyboardMapOverlay.cs. -->
                    <StackPanel x:Name="ShortcutKeyboardHost" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Film grain overlay — main content area only -->
        <Border x:Name="GrainOverlay"
                Grid.Row="4"
                IsHitTestVisible="False"
                Opacity="0.15"
                Panel.ZIndex="9999">
            <Border.Background>
                <ImageBrush x:Name="GrainBrush"
                            TileMode="Tile"
                            ViewportUnits="Absolute"
                            Viewport="0,0,256,256"
                            Stretch="None"/>
            </Border.Background>
        </Border>
    </Grid>
</Window>
