<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BgDark" Color="#f5f7f9"/>
    <SolidColorBrush x:Key="BgPanel" Color="#ffffff"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#f0f3f5"/>
    <SolidColorBrush x:Key="TitleBarBackground" Color="#e8eef2"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#edf2f5"/>
    <SolidColorBrush x:Key="StatusBarBackground" Color="#e8eef2"/>
    <SolidColorBrush x:Key="BgHover" Color="#dfe8ed"/>
    <SolidColorBrush x:Key="BgPressed" Color="#cfdce4"/>
    <SolidColorBrush x:Key="BorderDim" Color="#c8d2da"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#c8d2da"/>
    <SolidColorBrush x:Key="AccentGreen" Color="#047857"/>
    <SolidColorBrush x:Key="AccentGreenDim" Color="#d1fae5"/>
    <!-- Flowing text-selection quads (upstream KillerPDF v1.6.5, #127). See Dark.xaml. -->
    <SolidColorBrush x:Key="SelectionAccent" Color="#047857"/>
    <!-- Select-tool box marquee, same accent at marquee alphas (was a hardcoded royal blue). -->
    <SolidColorBrush x:Key="MarqueeFill"   Color="#047857" Opacity="0.16"/>
    <SolidColorBrush x:Key="MarqueeStroke" Color="#047857" Opacity="0.47"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#4b5563"/>
    <SolidColorBrush x:Key="TextMuted" Color="#6b7280"/>
    <SolidColorBrush x:Key="WarningOrange" Color="#b45309"/>
    <SolidColorBrush x:Key="DangerRed" Color="#dc2626"/>
    <SolidColorBrush x:Key="DisabledForeground" Color="#9ca3af"/>
    <SolidColorBrush x:Key="ToolButtonBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="ToolButtonForeground" Color="#111827"/>
    <SolidColorBrush x:Key="ToolButtonHoverBackground" Color="#dfe8ed"/>
    <SolidColorBrush x:Key="ToolButtonPressedBackground" Color="#cfdce4"/>
    <SolidColorBrush x:Key="ToolButtonCheckedBackground" Color="#d1fae5"/>
    <SolidColorBrush x:Key="ToolButtonCheckedForeground" Color="#047857"/>
    <SolidColorBrush x:Key="ToolButtonDisabledForeground" Color="#9ca3af"/>

    <!-- Shortcut-overlay keyboard: per-category key colors (upstream KillerPDF v1.6.4 "KsCat*").
         Deeper, saturated variants that read against the light keycap faces. -->
    <SolidColorBrush x:Key="KsCatFile"   Color="#2563eb"/>
    <SolidColorBrush x:Key="KsCatTools"  Color="#b45309"/>
    <SolidColorBrush x:Key="KsCatEdit"   Color="#db2777"/>
    <SolidColorBrush x:Key="KsCatNav"    Color="#7c3aed"/>
    <SolidColorBrush x:Key="KsCatView"   Color="#0891b2"/>
    <SolidColorBrush x:Key="KsCatSearch" Color="#059669"/>
    <SolidColorBrush x:Key="KsCatHelp"   Color="#ea580c"/>
    <SolidColorBrush x:Key="KsCatOcr"    Color="#dc2626"/>
</ResourceDictionary>
