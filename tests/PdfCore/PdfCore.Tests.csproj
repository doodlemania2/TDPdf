<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Exercises the PDF core: the parts of TDPdf that manipulate PDF structure rather than WPF.
    Redaction (does it REMOVE content, or merely cover it?), the canvas-to-PDF geometry every
    overlay depends on, the rasterise fallback, and AcroForm authoring.

    WHY THIS EXISTS
    TDPdf is a Windows WPF app and cannot run on the machines this repo usually lives on, so
    the PDF-editing core would otherwise ship unexercised. But PDFium itself is cross-platform,
    and bblanchon publishes the SAME revision the app ships (154.0.8035) for macOS and Linux.
    So this compiles the real Services/PdfiumInterop.cs - not a copy - and drives it against
    that native.

    It is a plain console exe returning a non-zero exit code on failure, so it needs no test
    runner, and it runs anywhere the repo is checked out — including Linux, which is what the
    release runner is.

    RUN
        cd tests/PdfCore && dotnet run
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PdfCore.Tests</AssemblyName>
    <!-- The file under test is written for the app's nullable settings, not this project's. -->
    <NoWarn>CS8600;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- All three natives so this runs wherever the repo is checked out; the resolver in
         Program.cs loads whichever one this machine can. -->
    <PackageReference Include="bblanchon.PDFium.macOS" Version="154.0.8035" />
    <PackageReference Include="bblanchon.PDFium.Linux" Version="154.0.8035" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="154.0.8035" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <!-- Test runner only: the app gets System.Security.Cryptography.Pkcs from the WindowsDesktop
         shared framework (net10.0-windows), which this plain net10.0 console does not reference.
         Nothing here ships, so it needs no THIRD-PARTY-NOTICES entry. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <ProjectReference Include="..\..\third_party\PdfSharpCore\PdfSharpCore.csproj" />
    <!-- THE REAL SHIPPING FILE. Compiled in, not duplicated. -->
    <Compile Include="..\..\Services\PdfiumInterop.cs" />
    <Compile Include="..\..\Services\CmapCoverage.cs" />
    <Compile Include="..\..\Services\PdfPageGeometry.cs" />
    <Compile Include="..\..\Services\MeasureGeometry.cs" />
    <Compile Include="..\..\Services\PdfSignatureScan.cs" />
    <Compile Include="..\..\Services\PdfSignatureInspector.cs" />
    <Compile Include="..\..\Services\PdfPageImageEncoder.cs" />
    <Compile Include="..\..\Services\PdfPageRasterizer.cs" />
    <Compile Include="..\..\Services\PdfRedaction.cs" />
    <Compile Include="..\..\Services\PdfTextSearch.cs" />
    <Compile Include="..\..\Services\PdfTextEdit.cs" />
    <Compile Include="..\..\Services\PdfContentInspector.cs" />
    <Compile Include="..\..\Services\PdfFormBuilder.cs" />
    <Compile Include="..\..\Services\PageBlockMove.cs" />
    <Compile Include="..\..\Services\PageIndexRemap.cs" />
    <Compile Include="..\..\Services\PdfPageDuplicate.cs" />
    <Compile Include="..\..\Services\TextLetterSpacing.cs" />
    <Compile Include="..\..\Services\RtlTextLayout.cs" />
    <Compile Include="..\..\Services\SelectCursorPolicy.cs" />
    <Compile Include="..\..\Services\PortableInstallPolicy.cs" />
    <Compile Include="..\..\Services\ZoomAnchorMath.cs" />
    <Compile Include="..\..\Services\WindowFitMath.cs" />
    <Compile Include="..\..\Services\PdfImages.cs" />
    <Compile Include="..\..\Services\InkDot.cs" />
    <!-- Electronic Signature: the WPF-free parts. The registry reads in DocumensoConfig are
         guarded by OperatingSystem.IsWindows(), and Settings.Default is shimmed in Shims.cs. -->
    <Compile Include="..\..\Services\DocumensoConfig.cs" />
    <Compile Include="..\..\Services\DocumensoModels.cs" />
    <Compile Include="..\..\Services\DocumensoClient.cs" />
    <Compile Include="..\..\Services\DocumensoFieldGeometry.cs" />
    <Compile Include="..\..\Services\DocumensoPlaceholders.cs" />
    <Compile Include="..\..\Services\DocumensoSend.cs" />
    <Compile Include="..\..\Services\DocumensoRequestStore.cs" />
    <Compile Include="..\..\Services\DocumensoRequests.cs" />
    <Compile Include="..\..\Services\DocumensoSelfSign.cs" />
    <Compile Include="..\..\Services\DocumensoBrowserSignIn.cs" />
    <Compile Include="..\..\Services\DocumensoWebNavigation.cs" />
    <Compile Include="..\..\Diagnostics\Sanitizer.cs" />
  </ItemGroup>

</Project>
